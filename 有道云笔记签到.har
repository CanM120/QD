  {
    "comment": "从 Cookie 提取 YNOTE_CSTK",
    "request": {
      "method": "GET",
      "url": "api://util/regex?p=(YNOTE_CSTK%3D[0-9a-zA-Z]*|YNOTE_CSTK=[0-9a-zA-Z]*)&data={{cookie|urlencode}}",
      "headers": [],
      "cookies": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "cstk",
          "re": "YNOTE_CSTK=([0-9a-zA-Z]+)",
          "from": "content"
        },
        {
          "name": "cstk",
          "re": "YNOTE_CSTK%3D([0-9a-zA-Z]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Windows 端签到状态 getSignStatus",
    "request": {
      "method": "POST",
      "url": "https://note.youdao.com/yws/mapi/user?method=getSignStatus&device_type=PC&_system=windows&_appName=ynote&_vendor=official-website&cstk={{cstk|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ynote-desktop/1.2.2 Chrome/87.0.4280.141 Electron/11.4.10 Safari/537.36"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },

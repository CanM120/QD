[
  {
    "comment": "会话保活 getsess（失败不影响后续）",
    "request": {
      "method": "GET",
      "url": "https://note.youdao.com/login/acc/pe/getsess?product=YNOTE",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "ynote-android"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "安卓客户端登录奖励 sync",
    "request": {
      "method": "POST",
      "url": "https://note.youdao.com/yws/api/daupromotion?method=sync",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "ynote-android"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "AUTHENTICATION_FAILURE",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "rewardSpace",
          "re": "\"rewardSpace\":(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "安卓端签到 checkin",
    "request": {
      "method": "POST",
      "url": "https://note.youdao.com/yws/mapi/user?method=checkin&_system=android",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "ynote-android"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"space\"|\"total\"",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "AUTHENTICATION_FAILURE",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "anspace",
          "re": "\"space\":(\\d+)",
          "from": "content"
        }
      ]
    }
  },

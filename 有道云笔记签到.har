  },
  {
    "comment": "生成日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&p=&s=&t=%E6%9C%89%E9%81%93%E4%BA%91%E7%AC%94%E8%AE%B0%E7%AD%BE%E5%88%B0%EF%BD%9C%E5%AE%89%E5%8D%93%E7%99%BB%E5%BD%95%E5%A5%96%E5%8A%B1%20{{ ((rewardSpace|default(0)|int) / 1048576)|round(2) }}%20MB%EF%BD%9C%E5%AE%89%E5%8D%93%E7%AD%BE%E5%88%B0%20{{ ((anspace|default(0)|int) / 1048576)|round(2) }}%20MB%EF%BD%9C%E8%A7%86%E9%A2%91%E5%B9%BF%E5%91%8A%20{{ (((adspace1|default(0)|int) + (adspace2|default(0)|int) + (adspace3|default(0)|int)) / 1048576)|round(2) }}%20MB%EF%BD%9CWindows%E7%AD%BE%E5%88%B0%20{{ ((w1space|default(0)|int) / 1048576)|round(2) }}%20MB%EF%BD%9C%E6%80%BB%E7%A9%BA%E9%97%B4%20{{ ((capacity|default(0)|int) / 1048576)|round(2) }}%20MB",
      "headers": [],
      "cookies": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": ".+",
          "from": "content"
        }
      ]
    }
  }
]